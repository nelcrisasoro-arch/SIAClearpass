{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Android APK (EAS preview)",
			"type": "shell",
			"command": "eas.cmd",
			"args": ["build", "--platform", "android", "--profile", "preview", "--non-interactive"],
			"options": {
				"cwd": "${workspaceFolder}/mobile-clearpass",
				"env": { "EAS_NO_VCS": "1" }
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}
